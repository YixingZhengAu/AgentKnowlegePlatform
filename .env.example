# ===== 应用 =====
# 本地开发 dev;临时公网部署时 deploy/release.sh 会把它改成 prod(见 documents/DEPLOY.md)
APP_ENV=dev
LOG_LEVEL=INFO
# 前端开发服务器地址(CORS 白名单,逗号分隔)。
# 线上是同源反代(Caddy 静态 + /api 转后端),这一项其实用不上,只作兜底。
CORS_ORIGINS=http://localhost:5173
# 上传原料与解析产物的本地落盘目录(相对仓库根)
FILE_STORAGE_DIR=./storage
# 对称加密密钥(datasources.dsn_enc 用,Fernet key:44 字符 base64)
# 生成:uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=please-generate-your-own-fernet-key

# ===== 文档 RAG(S2)重排 =====
# 以下五个值由 Step 5 评测集实测定稿(依据逐条见 documents/S2-PLAN.md 附录二)。
# 首次运行会下载 ~90MB 权重;进程内推理,30 条候选中位 207ms,模型加载后台预热
DOC_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 每条候选截到多少 token(512 是 BERT 家族位置数硬上限,余量留给 query)
DOC_RAG_RERANK_MAX_TOKENS=400
# 重排后喂给生成几条(hit@k 曲线:5→8 与 5→10 收益都是 0,到 @15 才多 1 题)
DOC_RAG_RERANK_TOPN=5
# rerank=纯用重排分;guard=整题最高分低于阈值时判定模型失灵,退回召回名次(实测 90%→95%)
DOC_RAG_RERANK_STRATEGY=guard
# guard 阈值:扫描全区间得最优平台 -4.86 ~ +0.02,取中点;两个边界各只有 1 个样本,评测集变大后重扫
DOC_RAG_RERANK_GUARD=-2.5
# 强制走本地权重缓存。关掉的话每次加载都要去 HuggingFace 核对版本,实测 3.1s → 13.2s。
# 前提:权重已由 bootstrap 的"预下载重排模型"那一步下好(约 90MB)
DOC_RAG_RERANK_OFFLINE=1

# 切分:沙箱 Step 5 评测集把失败题逐条查过,没有一道是切分造成的 → 定稿不改
DOC_RAG_CHUNK_MAX_TOKENS=512
DOC_RAG_CHUNK_OVERLAP=80
# 图表描述(整条摄取链唯一调 LLM 的地方,走 light tier)。关掉它可以零成本跑通摄取
DOC_RAG_DESCRIBE_FIGURES=1
DOC_RAG_DESCRIBE_CONCURRENCY=4
# 表格逐行覆盖的行数上限:15 曾把 18 行的表刚好卡进截断,丢掉的恰是表尾
DOC_RAG_TABLE_EXHAUSTIVE_ROWS=40
# 检索:两条腿各召回多少条进 RRF,以及 RRF 的平滑常数
DOC_RAG_VECTOR_TOPK=30
DOC_RAG_FTS_TOPK=30
DOC_RAG_RRF_K=60
# 命中片前后各带几片上下文(只记 seq,拼不拼由生成阶段决定)
DOC_RAG_CONTEXT_EXPAND=1
# 生成后校验:多一次 light 调用,结果只进 trace。默认关,演示时可开
DOC_RAG_VERIFY=false

# ===== LLM / Embedding(OpenAI)=====
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
# 重排:cross_encoder=本地 cross-encoder(S2 起默认);passthrough=原序返回(S0/S1 的占位实现)
RERANK_PROVIDER=cross_encoder

OPENAI_API_KEY=sk-你的key
OPENAI_BASE_URL=https://api.openai.com/v1

# 业务代码只说"要强模型还是快模型",tier -> 型号的映射只在这里
LLM_MODEL_MAIN=gpt-5
LLM_MODEL_LIGHT=gpt-5-mini

EMBEDDING_MODEL=text-embedding-3-small
# 换 embedding 供应商 = 换维度 = 重建向量列,不要随手改
EMBEDDING_DIM=1536

# Provider 行为:推理档位/推理 token 预留、超时(秒)、瞬时故障总尝试次数(含首次)、embedding 单请求最大条数
LLM_REASONING_EFFORT=low
LLM_REASONING_HEADROOM=2048
LLM_TIMEOUT_SEC=60
EMBEDDING_TIMEOUT_SEC=30
PROVIDER_MAX_ATTEMPTS=3
EMBEDDING_BATCH_SIZE=64

# ===== 精准问答(S1)=====
# MinerU 常驻解析容器(起法:make mineru;定义在 docker/mineru + 根 docker-compose.yml)
MINERU_API_URL=http://127.0.0.1:18001
MINERU_TIMEOUT_SEC=600
# 命中分档阈值:Step 5 用 27 条人写评测集实测定稿,别凭感觉改
# (正例余弦 0.61–0.91,所以 0.90 这类"看起来很稳"的值会把正例全挡在门外)
EXACT_QA_HIT_THRESHOLD=0.55
EXACT_QA_BORDERLINE_THRESHOLD=0.40
# 命中前用 light 模型复核一次(挡"同领域但原文没答案"的问题;实测 23/27 → 26/27)
EXACT_QA_HIT_GATE=true

# ===== 智能问数(S3)=====
# 执行闸:单次查询的读超时与返回行上限(B6 实测定稿,改前先跑 S3 评测集)
TEXT2SQL_QUERY_TIMEOUT_SEC=15
TEXT2SQL_MAX_ROWS=500

# ===== 数据库 =====
# 系统库(本系统全部业务表)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_system
# 演示业务库(智能问数的查询目标)= 独立的 MySQL 8.4 容器,端口 3307,只读账号。
# 它不是本系统的 engine:业务库由 datasources 表按行管理(连接串 Fernet 加密存 dsn_enc),
# 这一行只是"演示数据源"的出厂配置,seed 时加密写进那张表。
BIZ_DATABASE_URL=mysql+pymysql://biz_reader:biz_reader@127.0.0.1:3307/demo_biz
