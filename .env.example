# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
# 前端开发服务器地址(CORS 白名单,逗号分隔)
CORS_ORIGINS=http://localhost:5173
# 上传原料与解析产物的本地落盘目录(相对仓库根)
FILE_STORAGE_DIR=./storage
# 对称加密密钥(datasources.dsn_enc 用,Fernet key:44 字符 base64)
# 生成:uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=please-generate-your-own-fernet-key

# ===== LLM / Embedding(OpenAI)=====
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
RERANK_PROVIDER=passthrough

OPENAI_API_KEY=sk-你的key
OPENAI_BASE_URL=https://api.openai.com/v1

# 业务代码只说"要强模型还是快模型",tier -> 型号的映射只在这里
LLM_MODEL_MAIN=gpt-5
LLM_MODEL_LIGHT=gpt-5-mini

EMBEDDING_MODEL=text-embedding-3-small
# 换 embedding 供应商 = 换维度 = 重建向量列,不要随手改
EMBEDDING_DIM=1536

# ===== 数据库 =====
# 系统库(本系统全部业务表)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_system
# 演示业务库(智能问数的查询目标),用只读账号连
BIZ_DATABASE_URL=postgresql+asyncpg://biz_reader:biz_reader@localhost:5432/clenergy_biz
