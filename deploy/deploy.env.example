# 部署侧配置(不是应用配置 —— 应用配置在仓库根的 .env)
# 用法:cp deploy.env.example deploy.env,填好后跑 ./release.sh
# deploy.env 已在 .gitignore 里,不入库。

# 站点地址:Caddy 用它签证书并只服务这个 host。
#   有自己的域名:agent.example.com(先把 A 记录指向本机公网 IP)
#   没有域名:<公网IP>.nip.io(nip.io 把 IP 解析回自己,Let's Encrypt 照签)
#   完全不要 HTTPS(不推荐):写 :80
SITE_ADDRESS=agent.example.com

# 全站 Basic Auth —— 系统没有登录态(硬编码 default_user),这道门是公网暴露的唯一屏障。
# 生成 hash:caddy hash-password --plaintext '你的密码'
BASIC_AUTH_USER=interviewer
BASIC_AUTH_HASH=$2a$14$replace-with-the-output-of-caddy-hash-password

# 仓库在服务器上的绝对路径,以及跑后端的系统用户
REPO_ROOT=/home/ubuntu/agent-system
RUN_USER=ubuntu

# 后端监听(只绑 127.0.0.1,公网只经 Caddy 进来)
API_PORT=8000
